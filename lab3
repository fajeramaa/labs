data class Student(
    val name: String,
    val program: String,
    val gpa: String,
    val email: String,
    val city: String
)

@Composable
fun StudentCard(
    student: Student,
    modifier: Modifier = Modifier
) {
    Card(modifier = modifier.fillMaxWidth()) {
        Column(
            Modifier.padding(16.dp),
            verticalArrangement = Arrangement.spacedBy(8.dp)
        ) {
            Row(
                verticalAlignment = Alignment.CenterVertically
            ) {
                Box{
                    Box(
                        modifier = Modifier
                            .size(52.dp).clip(CircleShape).background(MaterialTheme.colorScheme.primary),
                        contentAlignment = Alignment.Center
                    ){
                        Text(
                            text = student.name
                                .split(" ")
                                .map{it.first()}
                                .joinToString { " " }
                        )
                    }
                    Box(
                        modifier = Modifier
                            .size(14.dp)
                            .align(Alignment.BottomEnd)
                            .clip(CircleShape)
                            .background(MaterialTheme.colorScheme.surface)
                            .padding(2.dp)
                            .clip(CircleShape)
                            .background(Color.Green)
                    )
                }
                Spacer(Modifier.width(12.dp))
                Column(
                    Modifier.weight(1f)
                ) {
                    Text(student.name)
                    Text(student.program)
                }

                Text("GPA: ${student.gpa}")
            }

            HorizontalDivider()

            Text(student.email)
            Text(student.city)
        }
    }
}

